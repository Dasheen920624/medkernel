{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "sbx-lab-critical-k",
      "ruleCode": "SBX.LAB.CRITICAL.K",
      "ruleType": "LAB",
      "triggerPoint": "result-review",
      "riskLevel": "CRITICAL",
      "actionCode": "STRONG_REMINDER",
      "reviewStatus": "APPROVED_FOR_SANDBOX",
      "reviewEvidence": "P5 幕6金样已完成规则命中、医师确认与服务端回查",
      "name": "血钾危急值红线",
      "sourceRef": "检验危急值管理制度",
      "changeSummary": "初始化沙盘高钾危急值金样，强提醒且不自动开立或修改医嘱",
      "clinicalContent": {
        "dsl": {
          "trigger": "result-review",
          "meta": {
            "parameters": [
              {
                "key": "observationCode",
                "label": "检验项",
                "valueType": "CODE",
                "required": true
              },
              {
                "key": "criticalThreshold",
                "label": "危急阈值",
                "valueType": "DECIMAL",
                "required": true
              },
              {
                "key": "returnMinutes",
                "label": "回报时限分钟",
                "valueType": "INTEGER",
                "required": true
              }
            ]
          },
          "applicability": {
            "population": {},
            "orgScope": {},
            "settings": [
              "INPATIENT",
              "OUTPATIENT",
              "ED",
              "FOLLOWUP"
            ],
            "effective": {
              "rolloutPercent": 100
            }
          },
          "when": {
            "all": [
              {
                "expr": {
                  "field": "observations[].valueNumeric",
                  "select": "latest",
                  "where": {
                    "all": [
                      {
                        "expr": {
                          "field": "observations[].code"
                        },
                        "operator": "equals",
                        "value": {
                          "const": "2823-3"
                        }
                      }
                    ]
                  }
                },
                "operator": "gte",
                "value": 5.5
              }
            ]
          },
          "then": [
            {
              "actionCode": "STRONG_REMINDER",
              "atSeverity": "CRITICAL",
              "indicator": "critical",
              "summary": "检验结果达到危急值，需立即回报并人工确认",
              "detail": "命中后须在规定时限内完成危急值回报、确认与记录，不自动开立或修改医嘱。",
              "source": {
                "label": "检验危急值管理制度"
              },
              "suggestions": [],
              "overrideReasons": [],
              "requiresPhysicianConfirmation": true
            }
          ],
          "explain": {
            "title": "血钾危急值回报",
            "summary": "沙盘金样按检验编码和危急阈值生成可追溯提醒"
          }
        },
        "testCases": [
          {
            "caseType": "POSITIVE",
            "patientId": "SBX-LAB-K-POS",
            "encounterId": "SBX-LAB-K-ENC-POS",
            "observationCode": "2823-3",
            "observationName": "血清钾",
            "valueNumeric": 6.8,
            "expectedHit": true,
            "expectedSeverity": "CRITICAL",
            "expectedActionCode": "STRONG_REMINDER"
          },
          {
            "caseType": "NEGATIVE",
            "patientId": "SBX-LAB-K-NEG",
            "encounterId": "SBX-LAB-K-ENC-NEG",
            "observationCode": "2823-3",
            "observationName": "血清钾",
            "valueNumeric": 4.5,
            "expectedHit": false
          },
          {
            "caseType": "BOUNDARY",
            "patientId": "SBX-LAB-K-BND",
            "encounterId": "SBX-LAB-K-ENC-BND",
            "observationCode": "2823-3",
            "observationName": "血清钾",
            "valueNumeric": 5.5,
            "expectedHit": true,
            "expectedSeverity": "CRITICAL",
            "expectedActionCode": "STRONG_REMINDER"
          },
          {
            "caseType": "CONFLICT",
            "patientId": "SBX-LAB-K-CFL",
            "encounterId": "SBX-LAB-K-ENC-CFL",
            "observationCode": "2951-2",
            "observationName": "血清钠",
            "valueNumeric": 160,
            "expectedHit": false
          }
        ]
      }
    },
