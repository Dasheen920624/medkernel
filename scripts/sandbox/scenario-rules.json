        "scope": "SANDBOX_INSTITUTION",
        "customRule": true
      },
      "disclaimer": "仅限演练机构沙盘验证，不构成真实患者抗凝管理建议，不与平台主源生产规则自动关联。",
      "sources": [
        {
          "sourceType": "REGULATORY_DRUG_LABEL",
          "title": "WARFARIN SODIUM tablet label",
          "issuingBody": "U.S. National Library of Medicine DailyMed / FDA label source",
          "documentNumber": "SETID 558b7a0d-5490-4c1b-802e-3ab3f1efe760",
          "publicationDate": "2026-06-03",
          "url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=558b7a0d-5490-4c1b-802e-3ab3f1efe760",
          "retrievedAt": "2026-06-19",
          "applicability": "用于华法林治疗期间 INR 监测、出血风险观察和按适应证个体化调整；治疗窗不得跨适应证硬编码。"
        }
      ],
      "clinicalContent": {
        "dsl": {
          "applicability": {
            "population": {},
            "orgScope": { "groupIds": [], "hospitalIds": [], "deptIds": [] },
            "settings": ["FOLLOWUP"],
            "effective": { "rolloutPercent": 100 }
          },
          "when": {
            "all": [
              {
                "expr": { "field": "followUps[].abnormalFlag" },
                "operator": "in",
                "value": ["HIGH"]
              },
              {
                "expr": { "field": "observations[].code" },
                "operator": "in",
                "value": ["6301-6"]
              },
              {
                "expr": { "field": "observations[].criticalFlag" },
                "operator": "in",
                "value": ["HIGH"]
              }
            ]
          },
          "then": [
            {
              "actionCode": "STRONG_REMINDER",
              "indicator": "warning",
              "atSeverity": "HIGH",
              "summary": "抗凝随访与 INR 均标记高风险，需医师复核",
              "detail": "请结合适应证、个体治疗目标、出血表现和用药情况决定处置；不自动调整剂量、不自动停药或开立医嘱。",
              "source": { "label": "DailyMed 华法林钠片监管标签" },
              "suggestions": [],
              "overrideReasons": ["已完成医师评估并制定复查计划"],
              "requiresPhysicianConfirmation": true
            }
          ],
          "explain": {
            "title": "INR 异常随访",
            "summary": "使用机构异常标记，避免把单一治疗窗套用于所有适应证。"
          }
        },
        "testCases": [
          {
            "caseType": "POSITIVE",
            "patientId": "SBX-FU-001",
            "encounterId": "SBX-FU-ENC-001",
            "facts": {
              "followUps": [
                { "planType": "ANTICOAGULATION", "abnormalFlag": "HIGH" }
              ],
              "observations": [
                {
                  "code": "6301-6",
                  "displayName": "INR",
                  "valueNumeric": 4.5,
                  "criticalFlag": "HIGH"
                }
              ]
            },
            "expectedHit": true,
            "expectedSeverity": "HIGH",
            "expectedActionCode": "STRONG_REMINDER"
          },
          {
            "caseType": "NEGATIVE",
            "patientId": "SBX-INR-NEG",
            "encounterId": "SBX-INR-ENC-NEG",
            "facts": {
              "followUps": [
                { "planType": "ANTICOAGULATION", "abnormalFlag": "NORMAL" }
              ],
              "observations": [
                {
                  "code": "6301-6",
                  "displayName": "INR",
                  "valueNumeric": 2.5,
                  "criticalFlag": "NORMAL"
                }
              ]
            },
            "expectedHit": false
          },
          {
            "caseType": "BOUNDARY",
            "patientId": "SBX-INR-BND",
            "encounterId": "SBX-INR-ENC-BND",
            "facts": {
              "followUps": [
                { "planType": "ANTICOAGULATION", "abnormalFlag": "HIGH" }
              ],
              "observations": [
                {
                  "code": "6301-6",
                  "displayName": "INR",
                  "valueNumeric": 3,
                  "criticalFlag": "HIGH"
                }
              ]
            },
            "expectedHit": true,
            "expectedSeverity": "HIGH",
            "expectedActionCode": "STRONG_REMINDER"
          },
          {
            "caseType": "CONFLICT",
            "patientId": "SBX-INR-MIS",
            "encounterId": "SBX-INR-ENC-MIS",
