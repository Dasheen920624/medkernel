      "sources": [
        {
          "sourceType": "INTERNATIONAL_SAFETY_GUIDANCE",
          "title": "Medication Safety in Transitions of Care",
          "issuingBody": "World Health Organization",
          "documentNumber": "WHO/UHC/SDS/2019.9",
          "publicationDate": "2019-05-01",
          "url": "https://www.who.int/publications/i/item/WHO-UHC-SDS-2019.9",
          "retrievedAt": "2026-06-19",
          "applicability": "用于转衔场景的用药核对、信息传递和随访安排安全框架；不规定单个患者的具体处方。"
        }
      ],
      "clinicalContent": {
        "dsl": {
          "applicability": {
            "population": {},
            "orgScope": { "groupIds": [], "hospitalIds": [], "deptIds": [] },
            "settings": ["INPATIENT"],
            "effective": { "rolloutPercent": 100 }
          },
          "when": {
            "all": [
              {
                "expr": { "field": "encounters[].encounterType" },
                "operator": "in",
                "value": ["INPATIENT"]
              },
              {
                "expr": { "field": "encounters[].dischargeTime" },
                "operator": "exists"
              },
              {
                "expr": { "field": "followUps[].planType" },
                "operator": "is_missing"
              }
            ]
          },
          "then": [
            {
              "actionCode": "REMIND",
              "indicator": "warning",
              "atSeverity": "MEDIUM",
              "summary": "出院记录尚未关联随访计划，请完成转衔核查",
              "detail": "请核对出院用药信息、复诊安排和患者教育是否完整；不自动生成处方、不自动创建随访任务。",
              "source": { "label": "WHO 转衔用药安全材料" },
              "suggestions": [],
              "overrideReasons": [],
              "requiresPhysicianConfirmation": false
            }
          ],
          "explain": {
            "title": "出院转衔核查",
            "summary": "仅检查结构化随访计划存在性，不作治疗适应证推断。"
          }
        },
        "testCases": [
          {
            "caseType": "POSITIVE",
            "patientId": "SBX-DC-001",
