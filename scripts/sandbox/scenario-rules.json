              "encounters": [
                {
                  "encounterType": "INPATIENT",
                  "dischargeTime": "2026-06-19T03:00:00Z"
                }
              ],
              "followUps": [
                {
                  "planType": "DISCHARGE_FOLLOWUP",
                  "plannedAt": "2026-06-26T03:00:00Z"
                }
              ]
            },
            "expectedHit": false
          },
          {
            "caseType": "BOUNDARY",
            "patientId": "SBX-DC-BND",
            "encounterId": "SBX-DC-ENC-BND",
            "facts": {
              "encounters": [
                {
                  "encounterType": "INPATIENT",
                  "dischargeTime": "2026-06-19T03:00:00Z"
                }
              ],
              "followUps": [{ "planType": "" }]
