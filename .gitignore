# Build outputs
target/
**/target/

# Node dependencies and Vite cache (any level; frontend/.gitignore also covers its own)
node_modules/
**/node_modules/
.vite/
**/.vite/

# Maven local cache generated for this workspace
**/m2repo/

# Runtime logs
*.log
*.out
*.err
*.pid
*.mv.db
*.trace.db
/runtime/
**/var/audit-fallback/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.override.example
!.env.oracle.local.example
*.local
application-local.yml
application-secret.yml

# IDE and OS files
.claude/
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# AI tool workspaces (prevent accidental commits from other AI assistants)
.superpowers/
.workbuddy/
.aider*
.cursor/
.continue/
.copilot/
.cody/

# Temporary files
*.tmp
*.bak
~$*

# Browser test outputs
frontend/e2e-report/
frontend/test-results/
