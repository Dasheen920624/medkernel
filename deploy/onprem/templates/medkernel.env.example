# MedKernel 运行环境变量模板
# 部署：填好真实值后放 /zoesoft/medkernel/conf/medkernel.env（chmod 600，chown medkernel）。
# 安全：切勿把真实数据库口令 / 密钥提交到代码库；本文件只放占位与示例。
SPRING_PROFILES_ACTIVE=govcloud
SERVER_PORT=18080
SERVER_ADDRESS=127.0.0.1
MEDKERNEL_RUNTIME_ENV=govcloud
MEDKERNEL_DEPLOYMENT_MODE=onprem
# 发布脚本会在替换 JAR 时自动写入本次提交哈希或 JAR SHA-256，请勿长期保留 development。
MEDKERNEL_RUNTIME_RELEASE_FINGERPRINT=development

# ---- PostgreSQL 数据源（腾讯云轻量单机推荐）----
MEDKERNEL_GOV_DATABASE_DIALECT=postgres
MEDKERNEL_GOV_DB_URL=jdbc:postgresql://127.0.0.1:5432/medkernel
MEDKERNEL_GOV_DB_DRIVER=org.postgresql.Driver
MEDKERNEL_GOV_DB_USERNAME=<DB_USER>
MEDKERNEL_GOV_DB_PASSWORD=<DB_PASSWORD>

# ---- Oracle 数据源（老现场可改用）----
# MEDKERNEL_GOV_DATABASE_DIALECT=oracle
# MEDKERNEL_GOV_DB_URL=jdbc:oracle:thin:@//<ORACLE_HOST>:1521/<SERVICE_NAME>
# MEDKERNEL_GOV_DB_DRIVER=oracle.jdbc.OracleDriver
# MEDKERNEL_GOV_DB_USERNAME=<DB_USER>
# MEDKERNEL_GOV_DB_PASSWORD=<DB_PASSWORD>

# ---- 安全密钥（生产务必随机生成）----
# JWT：64 字节 base64url；集成凭证与 BOOTSTRAP：32 字节 base64url
#   Linux 示例：openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
MEDKERNEL_AUTH_JWT_SECRET=<RANDOM_64B_BASE64URL>
MEDKERNEL_INTEGRATION_SECRET_KEY=<RANDOM_32B_BASE64URL>
MEDKERNEL_FIELD_ENCRYPTION_KEY=<RANDOM_32B_BASE64URL>
MEDKERNEL_BOOTSTRAP_INIT_TOKEN=<RANDOM_32B_BASE64URL>
MEDKERNEL_BOOTSTRAP_INIT_TOKEN_TTL_MINUTES=1440

# ---- 特性开关（按现场资源开启）----
MEDKERNEL_GRAPH_ENABLED=false
MEDKERNEL_DIFY_ENABLED=false
MEDKERNEL_EXTERNAL_PROVIDER_ENABLED=false
MEDKERNEL_BACKUP_ENABLED=false
MEDKERNEL_BACKUP_RPO=24h
MEDKERNEL_BACKUP_RTO=4h
MEDKERNEL_BACKUP_DRILL_EVIDENCE_FILE=/zoesoft/medkernel/backups/drills/latest-restore-drill.properties
MEDKERNEL_NEO4J_HEALTH_ENABLED=false

# ---- JVM ----
JAVA_OPTS="-server -Xms256m -Xmx768m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/zoesoft/medkernel/logs/heap.hprof -Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -Djava.security.egd=file:/dev/./urandom"
