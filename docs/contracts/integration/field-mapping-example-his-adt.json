{
  "baseUrl": "https://his.example.test/api",
  "healthPath": "/health",
  "outboundPath": "/events",
  "connectTimeoutMs": 2000,
  "requestTimeoutMs": 5000,
  "fieldMappings": [
    {
      "sourcePath": "/patientId",
      "targetPath": "/patient/mpi"
    },
    {
      "sourcePath": "/encounter/departmentId",
      "targetPath": "/admission/departmentId"
    },
    {
      "sourcePath": "/diagnoses/0/code",
      "targetPath": "/diagnoses/0",
      "targetDictionaryKey": "ICD-10",
      "category": "DIAGNOSIS"
    },
    {
      "sourcePath": "/diagnoses/0/sourceRecordId",
      "targetPath": "/diagnoses/0/sourceRecordId"
    },
    {
      "sourcePath": "/results/0/code",
      "targetPath": "/results/0",
      "targetDictionaryKey": "LOINC",
      "category": "LAB"
    },
    {
      "sourcePath": "/results/0/valueNumeric",
      "targetPath": "/results/0/valueNumeric"
    },
    {
      "sourcePath": "/results/0/unit",
      "targetPath": "/results/0/unit"
    },
    {
      "sourcePath": "/results/0/sourceRecordId",
      "targetPath": "/results/0/sourceRecordId"
    },
    {
      "sourcePath": "/dialysis/accessType",
      "targetPath": "/extensions/local/dialysis_access_type"
    }
  ]
}
