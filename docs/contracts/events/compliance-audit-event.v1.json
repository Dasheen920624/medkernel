{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance-audit-event.v1",
  "title": "合规审计展示事件 v1",
  "type": "object",
  "x-medkernel-version": 1,
  "required": [
    "id",
    "eventId",
    "occurredAt",
    "actorUserId",
    "summary",
    "actionCode",
    "resourceType",
    "resourceId",
    "traceId",
    "signature",
    "status",
    "actorRoles",
    "orgPath",
    "environmentKey",
    "outcome",
    "errorCode",
    "payloadDigest",
    "beforeSnapshot",
    "afterSnapshot",
    "superAdminAction"
  ],
  "properties": {
    "id": { "type": ["string", "null"] },
    "eventId": { "type": ["string", "null"] },
    "occurredAt": { "type": ["string", "null"], "format": "date-time" },
    "actorUserId": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "actionCode": { "type": ["string", "null"] },
    "resourceType": { "type": ["string", "null"] },
    "resourceId": { "type": ["string", "null"] },
    "traceId": { "type": ["string", "null"] },
    "signature": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "actorRoles": { "type": ["string", "null"] },
    "orgPath": { "type": ["string", "null"] },
    "environmentKey": { "type": ["string", "null"] },
    "outcome": { "type": ["string", "null"] },
    "errorCode": { "type": ["string", "null"] },
    "payloadDigest": { "type": ["string", "null"] },
    "beforeSnapshot": { "type": ["string", "null"] },
    "afterSnapshot": { "type": ["string", "null"] },
    "superAdminAction": { "type": "boolean" }
  }
}
