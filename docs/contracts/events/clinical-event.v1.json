{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clinical-event.v1",
  "title": "临床事件流水 v1",
  "type": "object",
  "x-medkernel-version": 1,
  "required": [
    "id",
    "eventId",
    "tenantId",
    "eventType",
    "triggerPoint",
    "idempotencyKey",
    "callbackWebhookId",
    "orgScopeJson",
    "patientId",
    "encounterId",
    "sourceSystem",
    "packageVersion",
    "payloadDigest",
    "occurredAt",
    "receivedAt",
    "snapshotId",
    "processingStatus",
    "errorCode",
    "errorClass",
    "retryCount",
    "rootEventId",
    "traceId"
  ],
  "properties": {
    "id": { "type": ["integer", "null"] },
    "eventId": { "type": ["string", "null"] },
    "tenantId": { "type": ["string", "null"] },
    "eventType": { "type": ["string", "null"] },
    "triggerPoint": { "type": ["string", "null"] },
    "idempotencyKey": { "type": ["string", "null"] },
    "callbackWebhookId": { "type": ["string", "null"] },
    "orgScopeJson": { "type": ["string", "null"] },
    "patientId": { "type": ["string", "null"] },
    "encounterId": { "type": ["string", "null"] },
    "sourceSystem": { "type": ["string", "null"] },
    "packageVersion": { "type": ["string", "null"] },
    "payloadDigest": { "type": ["string", "null"] },
    "occurredAt": { "type": ["string", "null"], "format": "date-time" },
    "receivedAt": { "type": ["string", "null"], "format": "date-time" },
    "snapshotId": { "type": ["string", "null"] },
    "processingStatus": { "type": ["string", "null"] },
    "errorCode": { "type": ["string", "null"] },
    "errorClass": { "type": ["string", "null"] },
    "retryCount": { "type": ["integer", "null"] },
    "rootEventId": { "type": ["string", "null"] },
    "traceId": { "type": ["string", "null"] }
  }
}
