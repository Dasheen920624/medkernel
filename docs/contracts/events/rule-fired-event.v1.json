{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-fired-event.v1",
  "title": "规则命中事件 v1",
  "type": "object",
  "x-medkernel-version": 1,
  "required": [
    "tenantId",
    "traceId",
    "runtimeReleaseId",
    "ruleId",
    "ruleCode",
    "versionId",
    "executionId",
    "triggerPoint",
    "eventId",
    "patientId",
    "encounterId",
    "severity",
    "actions",
    "occurredAt"
  ],
  "properties": {
    "tenantId": { "type": ["string", "null"] },
    "traceId": { "type": ["string", "null"] },
    "runtimeReleaseId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": ["string", "null"] },
    "ruleCode": { "type": ["string", "null"] },
    "versionId": { "type": ["string", "null"] },
    "executionId": { "type": ["string", "null"] },
    "triggerPoint": { "type": ["string", "null"] },
    "eventId": { "type": ["string", "null"] },
    "patientId": { "type": ["string", "null"] },
    "encounterId": { "type": ["string", "null"] },
    "severity": { "type": ["string", "null"] },
    "actions": { "type": ["array", "null"], "items": { "type": "string" } },
    "occurredAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
